{
  "name": "common_frame_vue3",
  "description": "毫米波雷达控制端",
  "author": "MillimeterWaveRadar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --mode dev",
    "test": "vite --mode test",
    "pro": "vite --mode pro",
    "build": "vite build --mode pro",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --mode dev\" \"npm run electron:start\"",
    "electron:start": "wait-on -t 120000 tcp:127.0.0.1:1573 && npx electron .",
    "electron:build": "vite build --mode pro && electron-builder",
    "electron:build:mac": "vite build --mode pro && electron-builder --mac",
    "electron:build:mac:dmg": "vite build --mode pro && electron-builder --mac dmg",
    "electron:build:win": "vite build --mode pro && electron-builder --win"
  },
  "dependencies": {
    "@better-scroll/core": "2.5.0",
    "@better-scroll/observe-dom": "2.5.0",
    "@better-scroll/observe-image": "2.5.0",
    "@better-scroll/pull-down": "2.5.0",
    "@better-scroll/pull-up": "2.5.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@vitejs/plugin-legacy": "2.3.1",
    "@vueuse/core": "9.6.0",
    "@vueuse/router": "9.6.0",
    "axios": "0.27.2",
    "crypto-js": "^4.2.0",
    "echarts": "5.4.0",
    "js-sha256": "^0.11.1",
    "mitt": "3.0.0",
    "moment": "2.29.4",
    "mqtt": "^4.1.0",
    "pinia": "2.0.22",
    "pinia-plugin-persistedstate": "2.2.0",
    "svgaplayerweb": "2.3.2",
    "three": "^0.181.0",
    "vant": "4.0.1",
    "vconsole": "3.14.7",
    "vite-plugin-html": "3.2.0",
    "vue": "3.2.37",
    "vue-router": "4.0.13",
    "websocket": "1.0.34"
  },
  "devDependencies": {
    "@rollup/plugin-inject": "5.0.2",
    "@vitejs/plugin-vue": "3.1.0",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "postcss-px-to-viewport": "1.1.1",
    "rollup-plugin-commonjs": "10.1.0",
    "rollup-plugin-copy": "3.4.0",
    "rollup-plugin-external-globals": "0.6.1",
    "sass": "1.55.0",
    "sass-loader": "13.1.0",
    "terser": "5.15.1",
    "unplugin-auto-import": "0.11.4",
    "unplugin-vue-components": "0.22.7",
    "vite": "3.2.5",
    "vite-plugin-resolve-externals": "0.2.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.millimeterwaveradar.app",
    "productName": "毫米波雷达",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "build-electron"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "electron/**/*",
      "www/controllPage/html/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "executableName": "MillimeterWaveRadar",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
