# just a flag
NODE_ENV = 'dev'

# base api
VITE_BASE_URL = 'https://test-envsplit.mymlsoft.com/'

# 局域网设备 HTTP（/api/getData 等；可按 IP 在 VITE_DEVICE_API_BASE_MAP 中映射完整 base）
VITE_LOCAL_DEVICE_HOST = '192.168.1.1'
VITE_LOCAL_DEVICE_PORT = '8089'
VITE_LOCAL_DEVICE_API_BASE = 'http://192.168.1.1:8089'
# 可选：{"192.168.1.1":"http://192.168.1.1:8089","10.0.0.1":"http://10.0.0.1:9000"}
# VITE_DEVICE_API_BASE_MAP =

# 雷达云端 HTTP（登录等，非 dev 代理时直连）
VITE_RADAR_HTTP_BASE = 'https://mmradar.inchitech.com'
